# Copy to .env and fill in. Never commit .env.

# Public hostname. Caddy fetches a Let's Encrypt certificate for it, so its DNS
# must point at this machine and ports 80/443 must be open. Use `localhost` to
# try the platform on your own machine (Caddy then issues a local certificate
# your browser will warn about).
DOMAIN=localhost

# Image versions. Defaults live in compose.yml; override to upgrade.
# BACKEND_VERSION=v0.10.13
# FRONTEND_VERSION=v0.9.11

# --- Required ---------------------------------------------------------------

# Who runs this instance. Shown to interview participants as the address for
# questions and corrections about their interview, and in email footers, so use
# an address you (or your institution's data-protection contact) answer.
CONTACT_EMAIL=

# Generate each with: openssl rand -hex 32
APP_SECRET__JWT_SECRET_KEY=
APP_SECRET__SESSION_SECRET_KEY=

# --- Model providers --------------------------------------------------------
# Set the key for every provider prefix used in config.toml's [llm] models
# (`openrouter:`, `openai:`, ...). OpenRouter alone is enough to get started.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- Email (optional) -------------------------------------------------------
# Needed for self sign-up, email verification, two-factor login codes,
# password resets and emailing participants. Without it, create accounts with
# scripts/create_admin.py. The SMTP server and addresses go in config.toml.
# APP_SERVICE__EMAIL__SENDER__PASSWORD=
# APP_SERVICE__EMAIL__RECIPIENT__PASSWORD=
